<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions bindingId="risco"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">

	<thing-type id="zone">
		<supported-bridge-type-refs>
			<bridge-type-ref id="bridge"/>
		</supported-bridge-type-refs>

		<label>Risco Zone</label>
		<description>Represents a physical device such as a door, window, or motion sensor</description>

		<channels>
			<channel id="open" typeId="zone_contact">
				<label>Open</label>
				<description>Open or Closed</description>
			</channel>
			<channel id="arm" typeId="readonly_switch">
				<label>Arm</label>
				<description>Armed or Disarmed</description>
			</channel>
			<channel id="alarm" typeId="readonly_switch">
				<label>Alarm</label>
				<description>Alarm or Standby</description>
			</channel>
			<channel id="tamper" typeId="readonly_switch">
				<label>Tamper</label>
				<description>Tamper or Hold</description>
			</channel>
			<channel id="trouble" typeId="readonly_switch">
				<label>Trouble</label>
				<description>Trouble or Sureness</description>
			</channel>
			<channel id="lost" typeId="readonly_switch">
				<label>Lost</label>
				<description>Lost or Located</description>
			</channel>
			<channel id="low_battery" typeId="readonly_switch">
				<label>Low Battery</label>
				<description>Low Battery or Battery Ok</description>
			</channel>
			<channel id="bypass" typeId="zone_bypass">
				<label>Bypass</label>
				<description>Bypassed or Unbypassed</description>
			</channel>
			<channel id="comm_trouble" typeId="readonly_switch">
				<label>Comm Trouble</label>
				<description>Communication Trouble or Communication Ok</description>
			</channel>
			<channel id="soak_test" typeId="readonly_switch">
				<label>Soak Test</label>
				<description>Soak Test or Exit Soak Test</description>
			</channel>
			<channel id="hours24" typeId="readonly_switch">
				<label>Hours 24</label>
				<description>24 Hours zone or Normal zone</description>
			</channel>
			<channel id="not_used" typeId="readonly_switch">
				<label>Not Used</label>
				<description>Zone not used or Zone used</description>
			</channel>

			<!-- Name -->
			<channel id="name" typeId="readonly_text">
				<label>Name</label>
				<description>The Zone name</description>
			</channel>
		</channels>

		<representation-property>zoneNumber</representation-property>

		<config-description>
			<parameter name="zoneNumber" type="integer" required="true" min="1" max="512">
				<label>Zone Number</label>
				<description>The Zone Number</description>
			</parameter>
		</config-description>

	</thing-type>

</thing:thing-descriptions>
